# ===== Unreal Engine 5 project .gitattributes (Git LFS) =====
# Template from GameTech-Lab/templates/ue5. Copy to the project root and run `git lfs install`.

# --- Text: normalize line endings ---
* text=auto
*.cpp     text eol=crlf
*.h       text eol=crlf
*.hpp     text eol=crlf
*.inl     text eol=crlf
*.cs      text eol=crlf
*.ini     text eol=crlf
*.uproject text eol=crlf
*.uplugin  text eol=crlf
*.usf     text eol=crlf
*.ush     text eol=crlf
*.py      text eol=lf
*.sh      text eol=lf
*.md      text
*.json    text
*.txt     text

# --- Unreal assets ---
# lockable lets `git lfs lock` prevent conflicting edits on binary assets
*.uasset  filter=lfs diff=lfs merge=lfs -text lockable
*.umap    filter=lfs diff=lfs merge=lfs -text lockable
*.ubulk   filter=lfs diff=lfs merge=lfs -text
*.uexp    filter=lfs diff=lfs merge=lfs -text
*.upk     filter=lfs diff=lfs merge=lfs -text

# --- Source art: 3D ---
